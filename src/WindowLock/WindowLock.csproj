<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WindowLock</AssemblyName>
    <RootNamespace>WindowLock</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\window-lock.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <InformationalVersion>0.2.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>flyingbrick88</Company>
    <Product>Window Lock</Product>
    <Description>Checks and controls Windows device-associated application policy.</Description>
    <Copyright>Copyright © 2026 flyingbrick88</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/flyingbrick88/window-lock-privacy</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\window-lock-logo.png" />
    <Content Include="Assets\window-lock.ico" />
  </ItemGroup>
</Project>
