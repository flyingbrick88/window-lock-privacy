<Window x:Class="WindowLock.ProtectionInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protection information" Width="700" Height="650" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F4F7FA"
        FontFamily="Segoe UI Variable Text, Segoe UI" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#102A43" Padding="28,22">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="MORE INFORMATION" Foreground="#A9D7CB" FontSize="12" FontWeight="Bold"/>
          <TextBlock x:Name="TitleText" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
        </StackPanel>
        <Border x:Name="CurrentBadge" Grid.Column="1" CornerRadius="20" Padding="16,9" VerticalAlignment="Center" Margin="20,0,0,0">
          <TextBlock x:Name="CurrentBadgeText" FontSize="13" FontWeight="Bold"/>
        </Border>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,24">
        <TextBlock x:Name="SummaryText" FontSize="16" Foreground="#486581" TextWrapping="Wrap" Margin="0,0,0,20"/>
        <Border Background="#E6FCF5" CornerRadius="16" Padding="20" Margin="0,0,0,14">
          <StackPanel><TextBlock Text="✓  When PROTECTED" Foreground="#087F5B" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="ProtectedText" Foreground="#243B53" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,0"/></StackPanel>
        </Border>
        <Border Background="#FFF0F0" CornerRadius="16" Padding="20" Margin="0,0,0,14">
          <StackPanel><TextBlock Text="!  When UNPROTECTED" Foreground="#C92A2A" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="UnprotectedText" Foreground="#243B53" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,0"/></StackPanel>
        </Border>
        <Border Background="White" CornerRadius="16" Padding="20" BorderBrush="#D9E2EC" BorderThickness="1">
          <StackPanel><TextBlock Text="Guidance" Foreground="#102A43" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="GuidanceText" Foreground="#486581" FontSize="14" TextWrapping="Wrap" LineHeight="21" Margin="0,9,0,12"/><TextBlock Text="Current Windows evidence" Foreground="#627D98" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="EvidenceText" Foreground="#486581" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,12"/><TextBlock Text="Policy source" Foreground="#627D98" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="SourceText" Foreground="#486581" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,12"/><TextBlock Text="Applies to" Foreground="#627D98" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="ApplicabilityText" Foreground="#486581" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="White" BorderBrush="#D9E2EC" BorderThickness="0,1,0,0" Padding="28,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="DocumentationButton" Content="Microsoft documentation" HorizontalAlignment="Left" Background="#E9EEF3" Foreground="#102A43" Click="Documentation_Click"/><Button Grid.Column="1" Content="Close" HorizontalAlignment="Right" Width="110" Background="#102A43" Foreground="White" Click="Close_Click"/></Grid>
    </Border>
  </Grid>
</Window>
