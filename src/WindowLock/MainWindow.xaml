<Window x:Class="WindowLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Lock" Width="980" Height="720" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F4F7FA" FontFamily="Segoe UI Variable Text, Segoe UI">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,14"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08"/></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#102A43" Padding="30,22">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Source="Assets/window-lock-logo.png" Width="58" Height="58" Margin="0,0,16,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Window Lock" Foreground="White" FontSize="26" FontWeight="Bold"/><TextBlock Text="You decide what gets installed." Foreground="#CFE8E1" FontSize="14"/></StackPanel>
        <Button Grid.Column="2" Content="Recent installations" Click="RecentInstallations_Click" Background="#274C68" Foreground="White" Margin="0,0,10,0"/>
        <Button Grid.Column="3" Content="Send feedback" Click="Feedback_Click" Background="#274C68" Foreground="White" Margin="0,0,10,0"/>
        <Button x:Name="UpdateStatusButton" Grid.Column="4" Content="Update protection status" Click="Refresh_Click" Background="#274C68" Foreground="White"/>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26">
      <Border x:Name="HeroCard" Style="{StaticResource Card}" Padding="26">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="HeroLabel" Text="PROTECTION STATUS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="HeroTitle" Text="Checking Windows protection" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="0,5,0,7"/><TextBlock x:Name="HeroText" Text="Reading Windows installation settings. Nothing is being changed." FontSize="15" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock x:Name="LastCheckedText" Text="Last checked: waiting for first check" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Green}" Margin="0,11,0,0"/><TextBlock x:Name="SystemSummaryText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock x:Name="SystemDetailText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Grid.Column="1" Width="320" Margin="24,0,0,0"><Border x:Name="HeroBadge" Background="{StaticResource AmberSoft}" CornerRadius="22" Padding="18,10" HorizontalAlignment="Right"><TextBlock x:Name="HeroBadgeText" Text="CHECKING" Foreground="{StaticResource Amber}" FontWeight="Bold" FontSize="15"/></Border><Border Background="#F4F7FA" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,12,0,0"><StackPanel><TextBlock Text="ABOUT &amp; PRIVACY" Foreground="{StaticResource Navy}" FontSize="12" FontWeight="Bold"/><TextBlock Text="Built by flyingbrick88 to make Windows privacy and update controls easy to understand and use." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="Created August 2026 · © 2026 flyingbrick88" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/><TextBlock Text="Licence: free noncommercial use · No account required" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/><TextBlock Text="No user identity or installed-app inventory is saved. Only local policy backup values needed for UNPROTECT are stored. Window Lock sends no data to any remote location for analytics, advertising, use, or sale." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border></StackPanel>
        </Grid>
      </Border>
      <Grid Margin="2,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Protection checks" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Navy}" VerticalAlignment="Center"/><Button x:Name="ToggleUnavailableButton" Grid.Column="1" Content="Hide unavailable options" Click="ToggleUnavailable_Click" Background="#E9EEF3" Foreground="{StaticResource Navy}" FontSize="13" Padding="15,9"/></Grid>
      <StackPanel x:Name="ChecksPanel"/>
    </StackPanel></ScrollViewer>
  </Grid>
</Window>
